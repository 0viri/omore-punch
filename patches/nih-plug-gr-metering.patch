+#[repr(C)]
+pub struct clap_plugin_gain_adjustment_metering {
+    pub get: Option<unsafe extern "C" fn(plugin: *const clap_plugin) -> f64>,
+}
+
 impl<P: ClapPlugin> Wrapper<P> {
+    const GAIN_ADJUSTMENT_METERING_VTABLE: clap_plugin_gain_adjustment_metering =
+        clap_plugin_gain_adjustment_metering {
+            get: Some(Self::ext_gain_adjustment_metering_get),
+        };
+
+    unsafe extern "C" fn ext_gain_adjustment_metering_get(plugin: *const clap_plugin) -> f64 {
